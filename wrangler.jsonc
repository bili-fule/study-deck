{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-deck",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-15",

  // The static frontend is deployed separately to EdgeOne.
  "routes": [{ "pattern": "stapi.xmfu.cn", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://st.xmfu.cn"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-deck",
      "database_id": "64d2cf2f-1b6e-4c34-a7e4-f58e87126bda",
      // Local development uses Miniflare storage.
      // Remote deployments bind the database created for this Worker.
      "migrations_dir": "migrations"
    }
  ]
}
