{
  "name": "study-deck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:build": "node scripts/build-bank.mjs",
    "data:coverage": "node scripts/analyze-knowledge-coverage.mjs",
    "data:test": "node scripts/test-bank-import.mjs",
    "cloud:test": "node scripts/test-cloud.mjs",
    "cf:dev": "wrangler dev --port 8787",
    "cf:migrate": "wrangler d1 migrations apply study-deck --local",
    "cf:migrate:remote": "wrangler d1 migrations apply study-deck --remote",
    "cf:typegen": "wrangler types",
    "cf:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "cf:deploy": "wrangler deploy",
    "admin:init": "node scripts/admin.mjs init",
    "admin:reset": "node scripts/admin.mjs reset"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.1",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "motion": "^12.42.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "4.162.0"
  }
}
